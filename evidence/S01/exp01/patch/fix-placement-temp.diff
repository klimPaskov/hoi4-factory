+/// Temporary leaf for placing new bytes at an operation's destination. It is
+/// derived from the transaction and operation like the quarantine name, so a
+/// file left by a hard stop between creation and rename is attributable.
+const PLACEMENT_PREFIX: &str = ".hoi4ms-placing-";
+
+fn placement_temp_leaf(quarantine_leaf: &str) -> String {
+    match quarantine_leaf.strip_prefix(QUARANTINE_PREFIX) {
+        Some(rest) => format!("{PLACEMENT_PREFIX}{rest}"),
+        None => format!(
+            "{PLACEMENT_PREFIX}{}.tmp",
+            &sha256_bytes(quarantine_leaf.as_bytes())[..32]
+        ),
+    }
+}
+
+/// Remove placement temporaries this transaction may have left in its
+/// operations' destination directories. The names are bound to the
+/// transaction ID, so no user file or other transaction can own them.
+fn remove_interrupted_placement_temps(
+    project: &RootedDir,
+    journal: &TransactionJournal,
+) -> Result<(), AppError> {
+    for operation in &journal.operations {
+        if operation.external
+            || matches!(
+                operation.action,
+                Some(OperationAction::Skip | OperationAction::External) | None
+            )
+        {
+            continue;
+        }
+        let leaf = placement_temp_leaf(&quarantine_leaf_name(
+            journal.transaction_id,
+            &operation.id,
+        ));
+        let relative = quarantine_relative(&operation.destination, &leaf)?;
+        if project.is_regular_file(&relative).unwrap_or(false) {
+            project.remove_file(&relative)?;
+        }
+    }
+    Ok(())
+}
