# Local configuration for docker compose. Copy to .env (git-ignored) and fill in.
# See docs/07-developer-workflow/DEVELOPER-SETUP.md.

# Hearts of Iron IV game folder, mounted read-only into the server (required).
HOI4_GAME_DIR=

# Anthropic API key for Setup analysis and agent runs (optional; features report unavailable without it).
FACTORY_ANTHROPIC_API_KEY=
# FACTORY_ANTHROPIC_MODEL=claude-haiku-5-5

# GitHub App private key file for the HOI4 Factory Dev App (optional; GitHub import is unavailable without it).
# FACTORY_GITHUB_APP_KEY_FILE=./.work/github-app/private-key.pem

# Host ports (optional).
# FACTORY_HOST_PORT=8080
# MAILPIT_UI_PORT=8025
